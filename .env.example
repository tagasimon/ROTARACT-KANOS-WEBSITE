# ── Required ──────────────────────────────────────────────
# PostgreSQL connection (Coolify: use the internal URL of your Postgres resource)
DATABASE_URL="postgresql://kanos:CHANGE_ME@postgres:5432/kanos?schema=public"
# Public URL of the site (used for canonical URLs, QR codes, sitemap)
APP_URL="https://kampalanorthrotaract.org"
# Long random string (openssl rand -hex 32). Signs sessions & QR codes.
SESSION_SECRET=""
# Protects /api/cron/* endpoints (send as "Authorization: Bearer <secret>")
CRON_SECRET=""

# ── Media storage ─────────────────────────────────────────
# "local" (files on a persistent Coolify volume) or "s3" (any S3-compatible store)
STORAGE_DRIVER="local"
STORAGE_LOCAL_DIR="/app/storage"
# S3 / MinIO / R2 / Backblaze (only when STORAGE_DRIVER=s3)
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_PUBLIC_URL=""   # optional CDN/public base URL; otherwise files are proxied via /media

# ── First admin (used by `npm run create-admin` / seed) ───
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
